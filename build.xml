<?xml version="1.0" encoding="UTF-8"?>

<project name="network-lib" default="jar" basedir=".">

    <!--
        Project directories.
        These properties let us reuse paths without repeating them.
    -->
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="dist.dir" value="dist"/>
    <property name="lib.dir" value="lib"/>

    <path id="project.classpath">
        <fileset dir="${lib.dir}">
            <include name="*.jar"/>
        </fileset>
    </path>

    <!-- Final JAR location and filename -->
    <property name="jar.file" value="${dist.dir}/network-lib.jar"/>

    <!--
        clean:
        Deletes all generated files so we can perform a fresh build.
    -->
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>

        <echo message="Clean complete."/>
    </target>

    <!--
        init:
        Creates directories needed by later targets.
    -->
    <target name="init">
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${dist.dir}"/>

        <echo message="Build directories created."/>
    </target>

    <!--
        compile:
        Compiles every .java file inside src.
        The depends attribute means init runs first.
    -->
    <target name="compile" depends="init">
        <javac
                srcdir="${src.dir}"
                destdir="${classes.dir}"
                includeantruntime="false"
                debug="true"
                encoding="UTF-8"
                release="22">

            <classpath refid="project.classpath"/>

            <compilerarg value="-Xlint:all"/>

        </javac>

        <echo message="Compilation complete."/>
    </target>

    <target name="run" depends="compile">
        <java
                classname="com.md.network.NetworkLauncher"
                fork="true"
                failonerror="true">

            <classpath>
                <pathelement location="${classes.dir}"/>
                <path refid="project.classpath"/>
            </classpath>

        </java>
    </target>

    <!--
        jar:
        Packages compiled .class files into network-lib.jar.
        compile runs first because jar depends on compile.
    -->
    <target name="jar" depends="compile">
        <jar
                destfile="${jar.file}"
                basedir="${classes.dir}">

            <manifest>
                <attribute name="Implementation-Title" value="Network Library"/>
                <attribute name="Implementation-Version" value="1.0.0"/>
                <attribute name="Created-By" value="Apache Ant"/>
            </manifest>
        </jar>

        <echo message="JAR created: ${jar.file}"/>
    </target>

    <!--
        rebuild:
        Performs a clean build from the beginning.
    -->
    <target name="rebuild" depends="clean,jar">
        <echo message="Rebuild complete."/>
    </target>

</project>
